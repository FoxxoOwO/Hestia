# ==========================================
# Hestia Smart Home OS - Konfigurace prostředí
# ==========================================

# Tajný klíč pro podepisování JWT tokenů - POVINNÉ, min. 32 znaků.
# Vygenerujte: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Bez něj aplikace odmítne nastartovat.
SECRET_KEY=

# Google Gemini API Klíč pro AI import receptů z internetu a volného textu
# Získejte zdarma na: https://aistudio.google.com/
GEMINI_API_KEY=

# Porty
BACKEND_PORT=8000
FRONTEND_PORT=3000

# CORS: čárkou oddělený seznam povolených originů. Výchozí "*" (přístup z LAN).
# Příklad: CORS_ORIGINS=http://localhost:3000,http://192.168.1.10:3000
CORS_ORIGINS=*
